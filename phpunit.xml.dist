<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd" bootstrap="vendor/silverstripe/cms/tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache">
  <php>
    <env name="SS_PHPUNIT_FLUSH" value="1"/>
  </php>
  <testsuites>
    <testsuite name="base-site">
      <directory>tests/</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix=".php">src/</directory>
    </include>
    <exclude>
      <directory suffix=".php">tests/</directory>
    </exclude>
  </source>
</phpunit>
